# Copy to .env and edit. .env is git-ignored.

# --- Training / evaluation -------------------------------------------------
# Folder that contains images/, masks/ and carinthia-s.csv (Carinthia-S release,
# https://zenodo.org/records/16895427). Never copied into this repository.
DATA_ROOT=D:\path\to\data-carinthia-s\extracted\data

# Where manifests, checkpoints, metrics and plots are written.
# ARTIFACTS_DIR=artifacts

# --- API service -----------------------------------------------------------
# The ONLY place the server loads weights from. Server starts without it and
# reports "not ready" until a trained checkpoint exists here.
MODEL_CHECKPOINT_PATH=weight/model_b/best.pt
# Directory with comparison.json / gallery assets produced by `python -m ml.compare`.
RESULTS_DIR=artifacts/results
# Built frontend (served from the same origin as the API in production).
FRONTEND_DIST=frontend/dist
MAX_UPLOAD_BYTES=5242880
# cpu or cuda; cpu works for checkpoints trained on CUDA.
INFERENCE_DEVICE=cpu
# Never enable in production: allows smoke/test-fixture checkpoints.
ALLOW_NON_TRAINED_CHECKPOINTS=false
